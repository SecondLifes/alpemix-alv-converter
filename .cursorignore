# =============================================================================
# .cursorignore — Alpemix ALV Converter AI Spec-Kit
# Excludes files and folders from Cursor AI indexing/context.
# See docs/ai-ignore-strategy.md for the full strategy.
# =============================================================================

# --- Build Artifacts ---
*.dcu
*.dcp
*.bpl
*.exe
*.pyc
*.pyo
__pycache__/
*.spec.bak

# --- IDE Temporary Files ---
*.identcache
*.local
*.stat
*.tvsconfig
__history/
__recovery/
.idea/
.vscode/
.serena/

# --- Build / Output Directories ---
build/
dist/
output/

# --- Dependencies and Caches ---
node_modules/
.venv/
.pytest_cache/
.mypy_cache/
modules/

# --- Sensitive Files ---
*.key
*.pfx
*.p12
.env
.env.*

# --- Large / Noisy Files ---
*.log
*.dmp
*.bak
*.tmp

# --- OS Artifacts ---
Thumbs.db
.DS_Store

# =============================================================================
# IMPORTANT: Do NOT add these paths — they are essential for AI context:
#   AGENTS.md
#   README.md
#   .agents/            (single source of truth: rules, commands, skills)
#   tools/               (generate-ai-configs.ps1)
#   .github/copilot-instructions.md
#   .claude/
#   .cursor/rules/
#   .gemini/
#   .kiro/
#   examples/
#   docs/
# =============================================================================

# --- Working staging area ---
# src/temp holds build scratch only: Delphi .dcu output, PyInstaller's work
# directory, and any local build venv. Nothing in it is worth indexing, and
# ffmpeg.exe under src/bin is 100 MB of binary.
src/temp/
src/bin/
